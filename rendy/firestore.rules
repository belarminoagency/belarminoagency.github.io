rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null && request.auth.token.email in [
        'belarminokaique581@gmail.com'
      ];
    }
    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
        match /bfight/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
    match /organizacao/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
    match /organizacao_dados/{uid} {
      allow read, write: if dono(uid) && (admin()
        || get(/databases/$(database)/documents/organizacao/$(uid)).data.aprovado == true);
    }
    // RENDY: liberação separada. Finanças ficam só no aparelho da pessoa.
    match /rendy/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }

    // ALTAR A DOIS: cada pessoa pede acesso e o Kaique libera (igual Rendy)
    function altarOk() {
      return admin() || (request.auth != null
        && get(/databases/$(database)/documents/altar/$(request.auth.uid)).data.aprovado == true);
    }
    match /altar/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
    // Área pessoal: só o dono
    match /altar_u/{uid}/{rest=**} {
      allow read, write: if dono(uid) && altarOk();
    }
    // Código da página do casal: só pega quem sabe o código (não dá para listar)
    match /altar_codigos/{code} {
      allow get: if altarOk();
      allow create: if altarOk() && request.resource.data.dono == request.auth.uid
        && request.auth.uid in getAfter(/databases/$(database)/documents/altar_casais/$(request.resource.data.casal)).data.membros;
      allow delete: if admin();
    }
    // Página do casal: no máximo 2 pessoas
    match /altar_casais/{cid} {
      function membroC() {
        return request.auth != null && request.auth.uid in
          get(/databases/$(database)/documents/altar_casais/$(cid)).data.membros;
      }
      allow read: if request.auth != null && request.auth.uid in resource.data.membros;
      allow create: if altarOk() && request.resource.data.membros == [request.auth.uid];
      allow update: if altarOk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'nomes'])
        && (
          // entrar com o código (só se tiver 1 pessoa)
          (resource.data.membros.size() == 1 && !(request.auth.uid in resource.data.membros)
            && request.resource.data.membros.size() == 2
            && request.auth.uid in request.resource.data.membros
            && request.resource.data.membros.hasAll(resource.data.membros))
          // sair da página
          || (request.auth.uid in resource.data.membros && !(request.auth.uid in request.resource.data.membros)
            && resource.data.membros.hasAll(request.resource.data.membros)
            && request.resource.data.membros.size() == resource.data.membros.size() - 1)
          // trocar o próprio nome
          || (request.auth.uid in resource.data.membros && request.resource.data.membros == resource.data.membros)
        );
      allow delete: if admin();
      match /{area}/{doc} {
        allow read, write: if membroC() && area in ['casal', 'revisoes', 'perfis', 'pedidos'];
      }
    }
      // NORTE: diário e metas pessoal, só o Kaique lê e escreve
    match /norte/{uid}/{rest=**} {
      allow read, write: if dono(uid) && admin();
    }
}
}
