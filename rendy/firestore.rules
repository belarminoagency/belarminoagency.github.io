rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null && request.auth.token.email in [
        'belarminokaique581@gmail.com'
      ];
    }
    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
        match /bfight/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
    match /organizacao/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
    match /organizacao_dados/{uid} {
      allow read, write: if dono(uid) && (admin()
        || get(/databases/$(database)/documents/organizacao/$(uid)).data.aprovado == true);
    }
    // RENDY: liberação separada. Finanças ficam só no aparelho da pessoa.
    match /rendy/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }

    // ALTAR A DOIS: espaço do casal. Só os dois e-mails do casal entram.
    match /altar_convites/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow create: if request.auth != null
        && request.auth.token.email in getAfter(/databases/$(database)/documents/altar_casais/$(request.resource.data.casal)).data.membros
        && email in getAfter(/databases/$(database)/documents/altar_casais/$(request.resource.data.casal)).data.membros;
      allow update, delete: if admin();
    }
    // Pedido de acesso: a pessoa pede, o Kaique (admin) libera ou recusa
    match /altar_pedidos/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if dono(uid) && request.resource.data.email == request.auth.token.email;
      allow delete: if admin() || dono(uid);
    }
    match /altar_casais/{cid} {
      function membro() {
        return request.auth != null && request.auth.token.email in
          get(/databases/$(database)/documents/altar_casais/$(cid)).data.membros;
      }
      allow read: if request.auth != null && request.auth.token.email in resource.data.membros;
      allow create: if request.auth != null
        && request.resource.data.membros.size() == 1
        && request.auth.token.email == request.resource.data.membros[0];
      allow update, delete: if admin();
      // Diário pessoal: só o dono lê e escreve
      match /data/users/{uid}/{dia} {
        allow read, write: if membro() && request.auth.uid == uid;
      }
      match /{area}/{doc} {
        allow read, write: if membro() && area in ['casal', 'revisoes', 'perfis', 'pedidos'];
      }
    }
  }
}
