rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null && request.auth.token.email in [
        'belarminokaique581@gmail.com'
      ];
    }
    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
        match /bfight/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
    match /organizacao/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
    match /organizacao_dados/{uid} {
      allow read, write: if dono(uid) && (admin()
        || get(/databases/$(database)/documents/organizacao/$(uid)).data.aprovado == true);
    }
    // RENDY: liberação separada. Finanças ficam só no aparelho da pessoa.
    match /rendy/{uid} {
      allow read: if admin() || dono(uid);
      allow create: if admin() || (dono(uid)
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false);
      allow update: if admin() || (dono(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aprovado', 'recusado', 'email']));
      allow delete: if admin();
    }
  }
}
